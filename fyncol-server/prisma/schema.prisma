generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODELOS SAAS (MULTI-TENANT)
// ==========================================

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String?  @unique
  phone     String?  @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // ID de la empresa en la pasarela de pagos (ej. id de cliente en Stripe)
  paymentProviderId String? @unique @map("payment_provider_id")

  subscription Subscription?
  users        User[]
  routes       Route[]

  @@map("companies")
}

model Subscription {
  id        Int      @id @default(autoincrement())
  plan      String   @default("BASIC") @db.VarChar(50)
  
  status    SubscriptionStatus @default(TRIAL)
  
  startDate DateTime @default(now()) @map("start_date")
  endDate   DateTime? @map("end_date") // Fecha en la que expira el Trial o el pago
  
  // ID de la suscripción en la pasarela de pagos
  providerSubscriptionId String? @unique @map("provider_subscription_id")
  
  companyId Int      @unique @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])

  @@map("subscriptions")
}

// ==========================================
// MODELOS CORE
// ==========================================

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(COBRADOR)
  createdAt DateTime @default(now()) @map("created_at")
  document  String?  @unique(map: "document")
  phone     String?
  address   String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  imageUrl  String?  @db.VarChar(255)

  companyId Int?     @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  route         Route?
  dailyClosures DailyClosure[]

  @@map("users")
}

model Route {
  id               Int      @id @default(autoincrement())
  country          String   @db.VarChar(100)
  city             String   @db.VarChar(100)
  currency         String   @db.VarChar(10)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  
  assignedToId     Int?     @unique @map("assigned_to_id")
  assignedTo       User?    @relation(fields: [assignedToId], references: [id])

  companyId        Int      @map("company_id")
  company          Company  @relation(fields: [companyId], references: [id])

  availableCapital Decimal  @default(0) @map("available_capital")
  transactions     CapitalTransaction[]

  clients       Client[]
  dailyClosures DailyClosure[]

  @@map("routes")
}

model CapitalTransaction {
  id          Int      @id @default(autoincrement())
  routeId     Int      @map("route_id")
  route       Route    @relation(fields: [routeId], references: [id])
  type        TransactionType
  amount      Decimal
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   Int      @map("created_by")

  @@map("capital_transactions")
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  documentId  String?  @unique @db.VarChar(50)
  phone       String?  @db.VarChar(50)
  address     String   @db.VarChar(255)
  latitude    Float?
  longitude   Float?
  documentUrl String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  
  routeId     Int      @map("route_id")
  route       Route    @relation(fields: [routeId], references: [id])

  loans       Loan[]

  @@map("clients")
}

model Loan {
  id               Int      @id @default(autoincrement())
  amount           Decimal
  installments     Int
  interestRate     Decimal
  
  periodicity      String   @default("DIARIO") @db.VarChar(20) 
  
  firstPaymentDate DateTime @map("first_payment_date")
  
  projectedTotal   Decimal
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  clientId         Int      @map("client_id")
  client           Client   @relation(fields: [clientId], references: [id])
  payments         Payment[]
  installmentDetails Installment[]
isRenewal       Boolean  @default(false) @map("is_renewal")
  @@map("loans")
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Decimal
  createdAt DateTime @default(now()) @map("created_at")

  loanId    Int      @map("loan_id")
  loan      Loan     @relation(fields: [loanId], references: [id])

  @@map("payments")
}

model Installment {
  id                Int       @id @default(autoincrement())
  installmentNumber Int       @map("installment_number")
  dueDate           DateTime  @map("due_date")
  expectedAmount    Decimal   @map("expected_amount")
  paidAmount        Decimal   @default(0) @map("paid_amount")
  
  status            String    @default("PENDING") @db.VarChar(20)
  paidAt            DateTime? @map("paid_at")
  wasLate           Boolean   @default(false) @map("was_late")
  promiseDate       DateTime? @map("promise_date")
  actionDescription String?   @map("action_description") @db.VarChar(255)
  
  loanId            Int       @map("loan_id")
  loan              Loan      @relation(fields: [loanId], references: [id])

  @@map("installments")
}

model DailyClosure {
  id               Int      @id @default(autoincrement())
  closedAt         DateTime @default(now()) @map("closed_at")

  availableCapital Decimal  @map("available_capital")
  totalPortfolio   Decimal  @map("total_portfolio")
  totalCollected   Decimal  @map("total_collected")
  newSales         Decimal  @map("new_sales")
  renewals         Decimal  @map("renewals")
  totalClients     Int      @map("total_clients")
  collectedClients Int      @map("collected_clients")
  overdueClients   Int      @map("overdue_clients")

  routeId          Int      @map("route_id")
  route            Route    @relation(fields: [routeId], references: [id])

  closedById       Int      @map("closed_by_id")
  closedBy         User     @relation(fields: [closedById], references: [id])

  @@map("daily_closures")
}

enum Role {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  COBRADOR
}

enum TransactionType {
  INVERSION
  RETIRO
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}