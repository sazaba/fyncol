generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(COBRADOR)
  createdAt DateTime @default(now()) @map("created_at")
  document  String?  @unique(map: "document")
  phone     String?
  address   String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  imageUrl  String?  @db.VarChar(255)

  // Relación (1:1): Un usuario solo puede tener MÁXIMO una ruta asignada a la vez.
  route     Route?
  dailyClosures DailyClosure[]

  @@map("users")
}

model Route {
  id               Int      @id @default(autoincrement())
  country          String   @db.VarChar(100)
  city             String   @db.VarChar(100)
  currency         String   @db.VarChar(10)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  
  assignedToId     Int?     @unique @map("assigned_to_id")
  assignedTo       User?    @relation(fields: [assignedToId], references: [id])

  // Campos de capital y movimientos
  availableCapital Decimal  @default(0) @map("available_capital") // Dinero disponible
  transactions     CapitalTransaction[] // Historial de movimientos

  // Relación con los clientes de esta ruta
  clients          Client[]
  dailyClosures DailyClosure[]

  @@map("routes")
}

model CapitalTransaction {
  id          Int      @id @default(autoincrement())
  routeId     Int      @map("route_id")
  route       Route    @relation(fields: [routeId], references: [id])
  type        TransactionType
  amount      Decimal  // Monto de la inversión o el retiro
  description String?  @db.VarChar(255) // Ej: "Inversión inicial" o "Retiro de utilidades"
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   Int      @map("created_by") // ID del ADMIN que hizo la operación

  @@map("capital_transactions")
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  documentId  String?  @unique @db.VarChar(50)
  phone       String?  @db.VarChar(50)
  address     String   @db.VarChar(255)
  latitude    Float?   // Para guardar la latitud del GPS
  longitude   Float?   // Para guardar la longitud del GPS
  documentUrl String?  @db.VarChar(255) // URL de la foto de la cédula
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Relación con la ruta (Un cliente pertenece a una ruta)
  routeId     Int      @map("route_id")
  route       Route    @relation(fields: [routeId], references: [id])

  // Relación con sus préstamos
  loans       Loan[]

  @@map("clients")
}

model Loan {
  id               Int      @id @default(autoincrement())
  amount           Decimal  // Monto prestado
  installments     Int      // Cantidad de cuotas
  interestRate     Decimal  // Porcentaje de interés mensual
  
  periodicity      String   @default("DIARIO") @db.VarChar(20) 
  
  // NUEVO CAMPO: Fecha en la que el cliente hará su primer pago
  firstPaymentDate DateTime @map("first_payment_date")
  
  projectedTotal   Decimal  // Métrica proyectada
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  clientId         Int      @map("client_id")
  client           Client   @relation(fields: [clientId], references: [id])
  payments         Payment[]
  installmentDetails Installment[]

  @@map("loans")
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Decimal  // Monto pagado en este abono
  createdAt DateTime @default(now()) @map("created_at")

  loanId    Int      @map("loan_id")
  loan      Loan     @relation(fields: [loanId], references: [id])

  @@map("payments")
}

model Installment {
  id                Int      @id @default(autoincrement())
  installmentNumber Int      @map("installment_number") // Cuota #1, #2, etc.
  dueDate           DateTime @map("due_date")           // Fecha en la que toca pagar
  expectedAmount    Decimal  @map("expected_amount")    // Lo que debería pagar
  paidAmount        Decimal  @default(0) @map("paid_amount") // Lo que realmente pagó
  
  status            String   @default("PENDING") @db.VarChar(20) // PENDING, PAID, PARTIAL, OVERDUE
  paidAt            DateTime? @map("paid_at")           // Cuándo lo pagó realmente
  wasLate           Boolean   @default(false) @map("was_late")
  promiseDate       DateTime? @map("promise_date")
  
  loanId            Int      @map("loan_id")
  loan              Loan     @relation(fields: [loanId], references: [id])

  @@map("installments")
}

model DailyClosure {
  id               Int      @id @default(autoincrement())
  closedAt         DateTime @default(now()) @map("closed_at")

  // Los 8 KPIs del Arqueo
  availableCapital Decimal  @map("available_capital") // DISPONIBLE
  totalPortfolio   Decimal  @map("total_portfolio")   // CARTERA
  totalCollected   Decimal  @map("total_collected")   // RECAUDO
  newSales         Decimal  @map("new_sales")         // VENTAS (CTES NUEVOS)
  renewals         Decimal  @map("renewals")          // RENOVACIONES (CTES VIEJOS)
  totalClients     Int      @map("total_clients")     // TOTAL RUTA
  collectedClients Int      @map("collected_clients") // CLIENTES COBRADOS
  overdueClients   Int      @map("overdue_clients")   // CLIENTES MORA

  // Relaciones
  routeId          Int      @map("route_id")
  route            Route    @relation(fields: [routeId], references: [id])

  closedById       Int      @map("closed_by_id") // El cobrador que hizo el cierre
  closedBy         User     @relation(fields: [closedById], references: [id])

  @@map("daily_closures")
}

enum Role {
  ADMIN
  SUPERVISOR
  COBRADOR
}

enum TransactionType {
  INVERSION
  RETIRO
}