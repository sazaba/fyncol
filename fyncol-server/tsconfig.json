{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
 "moduleResolution": "node10", // <-- EL CAMBIO ESTÁ AQUÍ
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
